{
  "appId": "com.animewing.tv",
  "appName": "AnimeWing TV",
  "webDir": "dist-tv",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "backgroundColor": "#07111F"
    }
  }
}
